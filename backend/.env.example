# Copy this file to .env and fill in the values. Never commit .env.

# development | production
ENVIRONMENT=development

# MongoDB connection string (Atlas: Database → Connect → Drivers).
MONGODB_URI=
# Database name for FluentDay, kept separate from other projects on the same cluster.
MONGODB_DB=fluentday

# Secret used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# In development it may be left empty (a temporary one is generated; you'll be logged out on restart).
JWT_SECRET=

# Where the React app runs (used for CORS and links in emails).
FRONTEND_URL=http://localhost:5173

# Comma-separated emails that become administrators when they register.
ADMIN_EMAILS=

# SMTP for verification / password-reset emails. If SMTP_HOST is empty (development),
# emails are printed to the backend console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FluentDay <no-reply@fluentday.app>

# Browser push reminders (optional). Leave empty to turn push off. Generate a pair with:
#   .venv/bin/python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@fluentday.app
# Free scheduler trigger (production): a long random value; also saved as the SCHEDULER_TOKEN GitHub secret.
SCHEDULER_TOKEN=

# Largest vocabulary PDF the admin may upload, in megabytes.
MAX_PDF_MB=50
# Proxies in front of the server (Vercel rewrite + Render = 2). Leave 0 when running locally.
TRUSTED_PROXY_HOPS=0

# Spaced repetition: days between revisions (learn on day 1 → revise on days 2, 4, 7, 15).
REVISION_GAPS=1,2,3,8
